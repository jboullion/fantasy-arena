{
  "name": "fantasy-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx apps/server/src/main.ts",
    "start:server": "tsx apps/server/src/main.ts",
    "test:run": "tsx tests/run-browser.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.50",
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/ws-transport": "^0.17.13",
    "@react-three/fiber": "^9.0.0",
    "@react-three/rapier": "^2.0.0",
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
